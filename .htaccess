# mediaexperts.ch — Apache config for the Infomaniak web hosting

ErrorDocument 404 /404.html
Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  # https only
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://mediaexperts.ch%{REQUEST_URI} [R=301,L]
  # www -> mediaexperts.ch
  RewriteCond %{HTTP_HOST} ^www\.mediaexperts\.ch$ [NC]
  RewriteRule ^ https://mediaexperts.ch%{REQUEST_URI} [R=301,L]
  # old WordPress addresses -> new pages
  RewriteRule ^(en)/?$ / [R=301,L]
  RewriteRule ^(impressum|agb|kontakt|contact)/?$ /impressum.html [R=301,L]
  # never serve git metadata or the repo's working files
  RewriteRule (^|/)\.git(/|$) - [F,L]
  RewriteRule ^(README\.md|build-lang\.py|\.gitignore|contact-config\.php|email(/.*)?)$ - [F,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(css|js|svg|png|jpg|jpeg|webp)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>
